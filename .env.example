# ARKCROW OBRA - configuración. Copie este archivo como ".env" y llene lo que necesite.
# El archivo .env NO se sube a GitHub ni entra en los respaldos de memoria.

# --- COSTO CERO (por defecto) ---
# Sin internet: modelo local + base local. Con internet: búsqueda web GRATUITA (DuckDuckGo/Wikipedia)
# resumida por el modelo local. No se usa ningún servicio de pago.
# auto = local para lo cotidiano, web gratuita cuando la pregunta necesita internet · local = nunca internet
ARKCROW_PREFERENCIA=auto

# --- Nube de PAGO (opcional, APAGADA). Solo se usa si pone "si" Y una clave. Tiene costo por uso. ---
ARKCROW_NUBE_DE_PAGO=no
ANTHROPIC_API_KEY=
ARKCROW_MODELO_NUBE=claude-opus-5-5
ARKCROW_ESFUERZO_NUBE=medium

# --- Modo offline: motor local (lo fija el instalador según la RAM del equipo) ---
OLLAMA_HOST=http://127.0.0.1:11434
ARKCROW_MODELO=qwen2.5:7b
ARKCROW_MODELO_RESP=qwen2.5:3b
ARKCROW_EMBED=bge-m3
ARKCROW_WHISPER=modelos/whisper-small

# --- Respaldos diarios (USB o carpeta sincronizada de la empresa) ---
ARKCROW_RESPALDOS=respaldos
ARKCROW_RESPALDOS_MAX=30

# --- Detección de internet (destinos de prueba, separados por coma) ---
# ARKCROW_PRUEBA_RED=https://api.anthropic.com/v1/models,https://www.google.com/generate_204
